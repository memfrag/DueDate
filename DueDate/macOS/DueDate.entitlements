<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Debug entitlements. Sandbox keys are injected by the ENABLE_APP_SANDBOX /
      ENABLE_OUTGOING_NETWORK_CONNECTIONS / ENABLE_USER_SELECTED_FILES build
      settings and are deliberately not repeated here.

      The CloudKit container environment is inferred as Development for
      development-signed builds, so it is not stated explicitly. See
      DueDate-Release.entitlements for the distribution counterpart.
    -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.io.apparata.DueDate</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <key>com.apple.developer.aps-environment</key>
    <string>development</string>
</dict>
</plist>
