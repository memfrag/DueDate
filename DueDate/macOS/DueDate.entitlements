<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Debug entitlements. Sandbox keys are injected by the ENABLE_APP_SANDBOX /
      ENABLE_OUTGOING_NETWORK_CONNECTIONS / ENABLE_USER_SELECTED_FILES build
      settings and are deliberately not repeated here.

      icloud-container-environment is stated explicitly rather than left to be
      inferred. Debug builds belong in the Development database, where the
      schema auto-creates; Production is frozen and append-only, so a model
      change tried out in a debug build against it would be permanent. Which
      environment an unannotated development-signed macOS build actually picks
      is not something we could establish from the logs, so both configurations
      say so outright. See DueDate-Release.entitlements for the counterpart.
    -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.io.apparata.DueDate</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <key>com.apple.developer.icloud-container-environment</key>
    <string>Development</string>
    <key>com.apple.developer.aps-environment</key>
    <string>development</string>
</dict>
</plist>
